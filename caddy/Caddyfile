# amber-infra edge config. Deployed to /etc/caddy/Caddyfile; per-app site blocks
# live in snippets/ and are pulled in by the import at the bottom.
#
# Caddyfile ordering is strict and non-obvious: the global options block must come
# first, snippet DEFINITIONS second, and site blocks last. `import` is evaluated
# textually, so it goes at the END — a file imported before the (common) snippet is
# defined fails to adapt with a confusing "unrecognized directive" error.

{
	email {$ACME_EMAIL}
	# The admin API on a unix socket, not off and not on a TCP port.
	#
	# `caddy reload` is the ONLY way to reload Caddy v2 — there is no SIGHUP, no
	# SIGUSR1 — and it works by POSTing to this endpoint. `admin off` therefore made
	# every reload fail with "connection refused", which is what install.sh hit the
	# moment it added its first site.
	#
	# A socket rather than localhost:2019 because the edge runs with
	# network_mode: host, so a TCP admin endpoint would bind the HOST's loopback and
	# be reachable by any local process — and admin API access is equivalent to root.
	# The socket lives inside the container and is not bind-mounted, so only Caddy
	# and anything with `docker exec` can reach it, which is the same trust boundary
	# as the reload command itself.
	admin unix//run/caddy-admin.sock
	servers {
		trusted_proxies static private_ranges
	}
}

# Shared behaviour every site gets. {args[0]} is the app name, used for the log file.
(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# Upstream settings for anything that streams: WebSockets, SSE, MCP streamable HTTP.
#
# flush_interval -1 disables response buffering. Without it Caddy holds an SSE chunk
# until its buffer fills, which reads to a voice client as "the agent hung" — it is
# the single most likely thing to break when Amber goes behind this proxy, because
# her whole design streams audio sentence by sentence.
(streaming) {
	flush_interval -1
	transport http {
		read_timeout 0
		write_timeout 0
	}
}

# What every agent-mcp-py app behind this edge needs: (streaming), plus a Host the
# app's MCP transport will accept.
#
# THE HOST REWRITE IS NOT COSMETIC. The MCP SDK's `streamable_http_app` takes
# host="127.0.0.1" as a default parameter and, when it is not handed explicit
# transport security, switches DNS-rebinding protection ON with a localhost-only
# allowlist. Caddy forwards the real hostname, so the app answered
# `421 Invalid Host header` to every call arriving through here.
#
# It hid behind the bearer gate, which runs in front of that check: an
# unauthenticated probe gets a 401 and never reaches it, so `curl https://…/mcp/`
# from the box looks healthy while the one correctly-credentialled caller in the
# ecosystem cannot connect. Rewriting Host to the loopback upstream lands inside the
# allowlist the SDK made up for itself.
#
# {upstream_hostport} is the address this proxy actually dialled, so it stays correct
# if the port changes. The original hostname is not lost — Caddy still sends
# X-Forwarded-Host, which is where an app should read it from anyway.
#
# agent-mcp-py now passes an allowlist built from its own public_url, which fixes
# this at the source. Keep this anyway: it costs nothing, and it is what makes a box
# running an older image work rather than fail in a way that took a day to find.
(proxied_mcp) {
	import streaming
	header_up Host {upstream_hostport}
}

import snippets/*.caddy
