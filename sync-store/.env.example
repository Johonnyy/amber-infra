# sync-store configuration. One prefix, no others.
#
# In production this file is NOT hand-edited: install/lib/secrets.sh renders it to
# /etc/amber-infra/sync-store/sync-store.env (mode 0600, root:root) from
# /etc/amber-infra/secrets.yaml. Edit the secrets file and re-run install.sh.

# --- Storage ---
# The container default. On a host run, a relative path is fine.
SYNC_STORE_DB_PATH=/data/sync-store.db
SYNC_STORE_BUSY_TIMEOUT_MS=5000

# --- Auth ---
# Comma separated, each entry a bare token or "name:token". The name is what gets
# logged when that caller registers — the token never is.
# EMPTY MEANS EVERY AUTHENTICATED REQUEST IS REJECTED. That is deliberate: a
# forgotten variable should be a loud failure, not a silently open registry.
# Generate with: openssl rand -hex 32
SYNC_STORE_KEYS=amber:CHANGEME,lucidity:CHANGEME,spawner:CHANGEME
# Local development only. Never set this on a box that is reachable.
SYNC_STORE_ALLOW_ANONYMOUS=false

# --- Registry ---
# Seconds after which a server is FLAGGED stale in GET /servers. 0 disables the
# flag. Filtering is opt-in per request (?include_stale=false) because
# PeerRegistry.refresh replaces its whole discovered layer: hiding a live but
# slow-to-heartbeat server removes it from every agent at once. See app/db.py.
SYNC_STORE_DEFAULT_STALE_AFTER_S=0

# --- Config sync (Lucidity) ---
SYNC_STORE_MAX_BLOB_BYTES=1048576
SYNC_STORE_CONFIG_HISTORY=50
